<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>DeepSWE descriptive matrix</title>
  <style>
    :root { color-scheme: light; --bg:#f3f5f2; --surface:#fff; --text:#17201b; --muted:#667169; --border:#d9ded9; }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--bg); color:var(--text); font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    main { width:min(1120px,calc(100% - 32px)); margin:0 auto; padding:40px 0 56px; }
    h1 { margin:0; font-size:clamp(2rem,4vw,3.1rem); letter-spacing:-.045em; }
    .lede { max-width:820px; color:var(--muted); line-height:1.55; }
    .card { border:1px solid var(--border); border-radius:16px; background:var(--surface); box-shadow:0 12px 36px rgba(30,48,38,.08); }
    .plot { margin-top:22px; padding:20px; }
    svg { display:block; width:100%; height:auto; }
    .axis { stroke:#98a39b; stroke-width:1; }
    .grid { stroke:#e4e8e4; stroke-width:1; }
    .label { fill:var(--muted); font-size:13px; }
    .point { stroke:#fff; stroke-width:4; }
    .legend { display:flex; flex-wrap:wrap; gap:10px 20px; margin-top:12px; color:var(--muted); font-size:.82rem; }
    .legend-item { display:flex; align-items:center; gap:7px; }
    .dot { width:10px; height:10px; border-radius:50%; }
    .arms { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-top:18px; }
    .arm { padding:15px; }
    .arm small,.arm span { display:block; color:var(--muted); }
    .arm h2 { margin:0 0 12px; font-size:1rem; }
    .arm strong { display:block; margin-top:3px; font-size:1.25rem; }
    .metric + .metric { margin-top:10px; }
    .limitations { margin-top:18px; padding:18px 22px; }
    .limitations h2 { margin:0; font-size:1rem; }
    .limitations ul { margin-bottom:0; padding-left:20px; color:var(--muted); line-height:1.5; }
    footer { margin-top:14px; color:var(--muted); font-size:.75rem; }
    @media (max-width:800px) { .arms { grid-template-columns:repeat(2,1fr); } }
    @media (max-width:480px) { .arms { grid-template-columns:1fr; } }
  </style>
</head>
<body>
<main>
  <h1>DeepSWE descriptive matrix</h1>
  <p class="lede">
    {{.TaskCount}} tasks selected by {{.Selector.Model}} · {{.Selector.Reasoning}}
    at a ${{printf "%.2f" .Selector.BudgetUSD}} published-cost budget proxy.
    Each point uses the same tasks, one run per task, fixed calibrations, and fixed weights.
  </p>

  <section class="card plot">
    <svg viewBox="0 0 780 380" role="img" aria-label="Score by price for four benchmark arms">
      <line class="grid" x1="70" y1="175" x2="730" y2="175"></line>
      <line class="axis" x1="70" y1="20" x2="70" y2="330"></line>
      <line class="axis" x1="70" y1="330" x2="730" y2="330"></line>
      <text class="label" x="60" y="25" text-anchor="end">{{percent .PlotMaximumScore}}</text>
      <text class="label" x="60" y="335" text-anchor="end">{{percent .PlotMinimumScore}}</text>
      <text class="label" x="70" y="352" text-anchor="middle">$0</text>
      <text class="label" x="730" y="352" text-anchor="middle">{{money .PlotMaximumPrice}}</text>
      <text class="label" x="400" y="376" text-anchor="middle">Price</text>
      <text class="label" x="16" y="175" text-anchor="middle" transform="rotate(-90 16 175)">Estimated full DeepSWE score</text>
      {{range .Arms}}
      <circle class="point" cx="{{printf "%.2f" .PlotX}}" cy="{{printf "%.2f" .PlotY}}" r="9" fill="{{.Color}}"></circle>
      {{end}}
    </svg>
    <div class="legend">
      {{range .Arms}}
      <span class="legend-item"><span class="dot" style="background:{{.Color}}"></span>{{.Label}}</span>
      {{end}}
    </div>
  </section>

  <section class="arms">
    {{range .Arms}}
    <article class="card arm">
      <h2>{{.Label}}</h2>
      <div class="metric"><span>Score</span><strong>{{percent .Score}}</strong></div>
      <div class="metric"><span>Price</span><strong>{{costRange .Cost}}</strong></div>
      <div class="metric"><span>Client</span><small>{{.ProviderClient}}</small></div>
      {{if gt .VerifierBuildFailedRuns 0}}<div class="metric"><span>Verifier build failures</span><strong>{{.VerifierBuildFailedRuns}}</strong></div>{{end}}
    </article>
    {{end}}
  </section>

  <section class="card limitations">
    <h2>Interpretation</h2>
    <ul>{{range .Limitations}}<li>{{.}}</li>{{end}}</ul>
  </section>

  <footer>
    Selection {{.SelectionID}} · generated {{.GeneratedAt}}
  </footer>
</main>
</body>
</html>
