<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Agent Layer benchmark report</title>
<link rel="icon" href="data:,">
<style>
:root {
  color-scheme: light;
  --canvas: #fafbfc;
  --surface: #fff;
  --surface-soft: #f6f8fa;
  --ink: #1f2937;
  --muted: #6b7280;
  --line: #e5e7eb;
  --line-strong: #cbd5e1;
  --brand: #629ad0;
  --brand-light: #80c7dc;
  --brand-dark: #3d74ac;
  --terminal: #1a2332;
  --positive: #15803d;
  --positive-soft: #eaf7ef;
  --negative: #b42318;
  --negative-soft: #fdefec;
  --neutral: #9a6700;
  --neutral-soft: #fff7df;
  --baseline: #64748b;
  --shadow: 0 16px 38px rgba(15, 23, 42, .07);
  --sans: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --mono: "JetBrains Mono", ui-monospace, "Cascadia Code", "SFMono-Regular", Consolas, monospace;
  font: 15px/1.55 var(--sans);
  font-synthesis: none;
}
* { box-sizing: border-box; }
html { background: var(--canvas); }
body {
  margin: 0;
  color: var(--ink);
  background:
    radial-gradient(circle at 4% 0%, rgba(128, 199, 220, .12), transparent 30rem),
    var(--canvas);
  -webkit-font-smoothing: antialiased;
}
button, summary { font: inherit; }
main { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 24px 0 58px; }
h1, h2, h3, p { margin-top: 0; }
h1 { margin-bottom: 6px; font-size: clamp(1.9rem, 4vw, 2.8rem); line-height: 1.05; letter-spacing: -.04em; }
h2 { margin-bottom: 6px; font-size: clamp(1.35rem, 2.5vw, 1.8rem); line-height: 1.15; letter-spacing: -.025em; }
h3 { margin-bottom: 6px; font-size: 1rem; }
a { color: var(--brand-dark); }
.report-header {
  padding: 16px 0 22px;
  border-top: 4px solid transparent;
  border-image: linear-gradient(90deg, var(--brand-light), var(--brand)) 1;
}
.report-nav { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-bottom: 26px; }
.brand-lockup { display: flex; align-items: center; gap: 10px; color: #374151; font: 700 .9rem/1 var(--mono); letter-spacing: -.02em; }
.brand-mark { width: 34px; height: 34px; }
.report-kind { color: var(--muted); font: 600 .72rem/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; }
.report-meta { margin: 8px 0 0; color: var(--muted); font-size: .86rem; }
.report-warning { margin: 0 0 16px; padding: 12px 14px; color: #7a4f00; background: var(--neutral-soft); border: 1px solid #ead28b; border-radius: 10px; }
.report-warning + .report-warning { margin-top: -8px; }
.section { margin: 42px 0 0; }
.section-head { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 16px; }
.section-intro { max-width: 720px; margin-bottom: 0; color: var(--muted); }
.metric-grid { display: grid; grid-template-columns: .78fr 1.25fr 1.25fr; gap: 14px; }
.metric-card {
  min-width: 0;
  min-height: 184px;
  padding: 22px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 14px;
  box-shadow: var(--shadow);
}
.metric-card.verdict-card { border-top: 4px solid var(--positive); }
.metric-card.verdict-card.worse { border-top-color: var(--negative); }
.metric-card.verdict-card.inconclusive { border-top-color: var(--neutral); }
.metric-label { display: block; margin-bottom: 20px; color: var(--muted); font: 700 .68rem/1 var(--mono); letter-spacing: .09em; text-transform: uppercase; }
.verdict-value { display: block; font-size: clamp(2rem, 4vw, 3rem); line-height: 1; letter-spacing: -.05em; }
.change-flow { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 10px; align-items: center; }
.change-side { min-width: 0; }
.change-side:last-child { text-align: right; }
.change-side small { display: block; margin-bottom: 4px; overflow: hidden; color: var(--muted); font-size: .7rem; text-overflow: ellipsis; text-transform: uppercase; white-space: nowrap; }
.change-side strong { font-size: clamp(1.45rem, 3vw, 2.15rem); letter-spacing: -.04em; }
.change-arrow { color: var(--brand); font: 700 1.25rem/1 var(--mono); }
.change-delta {
  display: inline-block;
  margin-top: 15px;
  padding: 5px 8px;
  color: var(--positive);
  background: var(--positive-soft);
  border-radius: 6px;
  font: 700 .78rem/1 var(--mono);
}
.change-delta.negative { color: var(--negative); background: var(--negative-soft); }
.metric-note { display: block; margin-top: 11px; color: var(--muted); font-size: .8rem; }
.positive { color: var(--positive); }
.negative { color: var(--negative); }
.neutral { color: var(--neutral); }
.tradeoff-panel { padding: 20px 20px 16px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); }
.chart-wrap { width: 100%; overflow: hidden; }
.tradeoff-chart { display: block; width: 100%; height: auto; min-height: 360px; }
.chart-grid { stroke: #edf0f3; stroke-width: 1; }
.chart-axis { stroke: #aeb8c4; stroke-width: 1.1; }
.chart-tick, .chart-label { fill: #6b7280; font: 12px var(--sans); }
.chart-axis-label { fill: #374151; font: 700 12px var(--mono); }
.chart-connection { fill: none; stroke: #bac4cf; stroke-width: 2; stroke-dasharray: 4 5; }
.chart-envelope { stroke-width: 1.5; }
.chart-point { stroke: #fff; stroke-width: 3; filter: drop-shadow(0 2px 3px rgba(15, 23, 42, .18)); }
.chart-point-label { fill: var(--ink); font: 700 13px var(--sans); }
.chart-point-value { fill: #6b7280; font: 11px var(--mono); }
.chart-overflow { fill: var(--negative); }
.chart-legend { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 8px; padding-top: 14px; color: var(--muted); border-top: 1px solid var(--line); font-size: .78rem; }
.legend-item { display: inline-flex; align-items: center; gap: 8px; }
.legend-envelope { width: 24px; height: 13px; background: rgba(98, 154, 208, .14); border: 1px solid var(--brand); border-radius: 5px; }
.legend-point { width: 11px; height: 11px; background: var(--brand); border: 2px solid #fff; border-radius: 50%; box-shadow: 0 0 0 1px var(--brand); }
.chart-note { margin: 12px 0 0; color: var(--muted); font-size: .76rem; }
.history-list { overflow: hidden; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); }
.history-row { display: grid; grid-template-columns: minmax(180px, 1.5fr) 110px 130px 130px; gap: 18px; align-items: center; padding: 17px 20px; }
.history-row + .history-row { border-top: 1px solid var(--line); }
.history-row small { display: block; color: var(--muted); }
.history-stat { text-align: right; font-variant-numeric: tabular-nums; }
.history-stat strong { display: block; }
.verdict-pill { display: inline-flex; align-items: center; gap: 6px; width: fit-content; padding: 5px 8px; color: var(--positive); background: var(--positive-soft); border-radius: 999px; font: 700 .7rem/1 var(--mono); text-transform: uppercase; }
.verdict-pill::before { width: 6px; height: 6px; background: currentColor; border-radius: 50%; content: ""; }
.verdict-pill.worse { color: var(--negative); background: var(--negative-soft); }
.verdict-pill.inconclusive { color: var(--neutral); background: var(--neutral-soft); }
.campaign-total { color: var(--muted); font: 600 .76rem/1.4 var(--mono); text-align: right; }
.campaign-total strong { display: block; color: var(--ink); font-size: 1rem; }
.task-list { overflow: hidden; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); }
.task-row { display: grid; grid-template-columns: minmax(210px, 1.25fr) minmax(260px, 1.5fr) 92px; gap: 22px; align-items: center; padding: 18px 20px; }
.task-row + .task-row { border-top: 1px solid var(--line); }
.task-name { min-width: 0; }
.task-name strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.task-name small { display: block; margin-top: 2px; color: var(--muted); }
.task-track {
  position: relative;
  height: 18px;
  background:
    linear-gradient(90deg, transparent calc(25% - .5px), #dfe5eb calc(25% - .5px), #dfe5eb calc(25% + .5px), transparent calc(25% + .5px)),
    linear-gradient(90deg, transparent calc(50% - .5px), #dfe5eb calc(50% - .5px), #dfe5eb calc(50% + .5px), transparent calc(50% + .5px)),
    linear-gradient(90deg, transparent calc(75% - .5px), #dfe5eb calc(75% - .5px), #dfe5eb calc(75% + .5px), transparent calc(75% + .5px)),
    #edf1f4;
  border-radius: 6px;
}
.task-segment { position: absolute; top: 4px; bottom: 4px; background: rgba(21, 128, 61, .32); border-radius: 3px; }
.task-segment.negative { background: rgba(180, 35, 24, .30); }
.task-point { position: absolute; top: 50%; width: 9px; height: 9px; border: 2px solid #fff; border-radius: 50%; transform: translate(-50%, -50%); box-shadow: 0 0 0 1px rgba(31, 41, 55, .35); }
.task-point.start { background: var(--baseline); }
.task-point.end { background: var(--positive); }
.task-point.end.negative { background: var(--negative); }
.task-delta { font: 700 .88rem/1 var(--mono); text-align: right; }
.supporting { margin-top: 48px; }
details { margin: 10px 0; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; }
summary { padding: 16px 18px; cursor: pointer; font-weight: 650; list-style-position: inside; }
details[open] summary { border-bottom: 1px solid var(--line); }
.details-body { padding: 4px 18px 20px; }
.details-body > p:first-child { margin-top: 14px; }
.note { color: var(--muted); }
.table-scroll { max-width: 100%; overflow-x: auto; }
table { width: 100%; margin-top: 12px; border-collapse: collapse; font-size: .82rem; }
th, td { padding: 10px 11px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
th { color: #4b5563; background: var(--surface-soft); font: 700 .68rem/1.35 var(--mono); letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }
tbody tr:last-child > * { border-bottom: 0; }
.number { text-align: right; font-variant-numeric: tabular-nums; }
.hash { font: .7rem/1.5 var(--mono); overflow-wrap: anywhere; }
.method-list { margin: 12px 0 0; padding-left: 1.2rem; }
.method-list li + li { margin-top: 7px; }
.footer { display: flex; justify-content: space-between; gap: 18px; margin-top: 30px; padding-top: 18px; color: var(--muted); border-top: 1px solid var(--line); font-size: .72rem; }
@media (max-width: 800px) {
  main { width: min(100% - 18px, 1120px); padding-top: 10px; }
  .metric-grid { grid-template-columns: 1fr; }
  .metric-card { min-height: 0; }
  .tradeoff-panel { padding: 12px 8px 14px; }
  .tradeoff-chart { min-height: 310px; }
  .history-row { grid-template-columns: minmax(0, 1fr) 96px; gap: 10px 14px; }
  .history-stat:nth-of-type(2), .history-stat:nth-of-type(3) { grid-row: 2; }
  .task-row { grid-template-columns: minmax(0, 1fr) 84px; gap: 12px; }
  .task-track { grid-column: 1 / -1; grid-row: 2; }
  .task-delta { grid-column: 2; grid-row: 1; }
  .section-head { display: block; }
  .campaign-total { margin-top: 10px; text-align: left; }
  .footer { display: block; }
}
@media (max-width: 430px) {
  .report-nav { align-items: flex-start; }
  .report-kind { max-width: 130px; text-align: right; }
  .change-flow { gap: 7px; }
  .metric-card { padding: 18px; }
  .task-row { padding: 16px; }
  summary { padding: 15px; }
  .details-body { padding-inline: 15px; }
}
@media print {
  :root { --canvas: #fff; }
  main { width: 100%; padding: 0; }
  .metric-card, .tradeoff-panel, .history-list, .task-list { box-shadow: none; }
  details > * { display: block; }
}
</style>
</head>
<body>
<main>
{{with .ObservedCampaign}}
  {{$current := currentObservedVersion .}}
  <header class="report-header">
    <div class="report-nav">
      <div class="brand-lockup">
        <svg class="brand-mark" viewBox="0 0 64 64" role="img" aria-label="Agent Layer">
          <defs><linearGradient id="brand-gradient" x1="8" y1="8" x2="56" y2="38" gradientUnits="userSpaceOnUse"><stop stop-color="#80c7dc"/><stop offset="1" stop-color="#629ad0"/></linearGradient></defs>
          <path d="M32 7 56 18 32 29 8 18 32 7Z" fill="none" stroke="url(#brand-gradient)" stroke-width="5" stroke-linejoin="round"/>
          <path d="m8 30 24 11 24-11M8 42l24 11 24-11" fill="none" stroke="#495159" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>agent-layer</span>
      </div>
      <span class="report-kind">Benchmark report</span>
    </div>
    <h1>Benchmark campaign</h1>
    <p class="report-meta">{{.Model}} · {{.Reasoning}} reasoning · {{.TaskCount}} selected {{if eq .TaskCount 1}}task{{else}}tasks{{end}} · {{.RunsPerArm}} runs per arm · {{len .Versions}} {{if eq (len .Versions) 1}}version{{else}}versions{{end}}</p>
  </header>

  {{range .Warnings}}<p class="report-warning"><strong>Campaign warning:</strong> {{.}}</p>{{end}}

  <section aria-label="Latest measured result">
    <div class="metric-grid">
      <article class="metric-card verdict-card {{$current.Verdict}}">
        <span class="metric-label">Latest result</span>
        <strong class="verdict-value {{if eq $current.Verdict "better"}}positive{{else if eq $current.Verdict "worse"}}negative{{else}}neutral{{end}}">{{if eq $current.Verdict "better"}}Better{{else if eq $current.Verdict "worse"}}Worse{{else}}Inconclusive{{end}}</strong>
        <span class="metric-note">{{$current.Label}} · version {{len .Versions}} of {{len .Versions}}</span>
      </article>
      <article class="metric-card">
        <span class="metric-label">Score change</span>
        <div class="change-flow">
          <div class="change-side"><small>{{.BaselineLabel}}</small><strong>{{printf "%.1f%%" (mul100 .BaselineMean)}}</strong></div>
          <span class="change-arrow">→</span>
          <div class="change-side"><small>{{$current.Label}}</small><strong>{{printf "%.1f%%" (mul100 $current.Mean)}}</strong></div>
        </div>
        <span class="change-delta {{if lt $current.ObservedDifference 0.0}}negative{{end}}">{{printf "%+.1f pts" (mul100 $current.ObservedDifference)}}</span>
        <span class="metric-note">±{{printf "%.1f" (mul100 $current.DecisionThreshold)}}-point threshold</span>
      </article>
      <article class="metric-card">
        <span class="metric-label">Cost change</span>
        <div class="change-flow">
          <div class="change-side"><small>{{.BaselineLabel}}</small><strong>${{printf "%.2f" .BaselineCost.Midpoint}}</strong></div>
          <span class="change-arrow">→</span>
          <div class="change-side"><small>{{$current.Label}}</small><strong>${{printf "%.2f" $current.Cost.Midpoint}}</strong></div>
        </div>
        <span class="change-delta">{{printf "%.1f" $current.CostMultiple}}×</span>
        <span class="metric-note">{{printf "%.1f" $current.CostMultipleMinimum}}×–{{printf "%.1f" $current.CostMultipleMaximum}}× accounting range</span>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="cost-score-tradeoff">
    <div class="section-head">
      <div>
        <h2 id="cost-score-tradeoff">Score and cost</h2>
        <p class="section-intro">The shared baseline and every campaign version on fixed score and campaign-specific cost axes.</p>
      </div>
    </div>
    <div class="tradeoff-panel">
      <div class="chart-wrap">
        <svg class="tradeoff-chart" id="tradeoff-chart" viewBox="0 0 900 500" role="img" aria-labelledby="tradeoff-chart-title tradeoff-chart-description">
          <title id="tradeoff-chart-title">Benchmark score plotted against arm cost</title>
          <desc id="tradeoff-chart-description">The shared bare-model baseline and campaign versions, with cost-accounting ranges horizontally and plus or minus one standard error score uncertainty vertically.</desc>
        </svg>
      </div>
      <div class="chart-legend" aria-hidden="true">
        <span class="legend-item"><i class="legend-envelope"></i> Cost-accounting range (width)</span>
        <span class="legend-item"><i class="legend-envelope"></i> Score uncertainty (height, ±1 standard error)</span>
        <span class="legend-item"><i class="legend-point"></i> Measured score and midpoint cost</span>
      </div>
      <p class="chart-note">Score uses a fixed 0–100% scale. Cost uses a logarithmic scale capped at ${{printf "%.0f" .CostAxis.MaximumUSD}}: the published {{.CostAxis.ReferenceConfiguration}} mean cost for these tasks and repetitions (${{printf "%.2f" .CostAxis.ReferenceEstimatedArmCostUSD}}), rounded up to ${{printf "%.0f" .CostAxis.RoundingIncrementUSD}}. Horizontal bounds are cost-accounting ranges; vertical bounds are ±1 standard error, not the better-or-worse threshold.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="campaign-history">
    <div class="section-head">
      <div>
        <h2 id="campaign-history">Campaign history</h2>
        <p class="section-intro">Every version remains visible against the same baseline.</p>
      </div>
      <div class="campaign-total">Campaign cost<strong>${{printf "%.2f" .CampaignCost.Midpoint}}</strong>{{costRange .CampaignCost.Minimum .CampaignCost.Maximum}}</div>
    </div>
    <div class="history-list">
      {{range $index, $version := .Versions}}<article class="history-row">
        <div>
          <strong>{{$version.Label}}</strong>
          <small>Version {{printf "%d" (add1 $index)}} · {{$version.TotalRuns}} runs</small>
        </div>
        <span class="verdict-pill {{$version.Verdict}}">{{if eq $version.Verdict "better"}}Better{{else if eq $version.Verdict "worse"}}Worse{{else}}Inconclusive{{end}}</span>
        <div class="history-stat"><small>Score change</small><strong class="{{if lt $version.ObservedDifference 0.0}}negative{{else}}positive{{end}}">{{printf "%+.1f pts" (mul100 $version.ObservedDifference)}}</strong><small>±{{printf "%.1f" (mul100 $version.DecisionThreshold)}} threshold</small></div>
        <div class="history-stat"><small>Arm cost</small><strong>${{printf "%.2f" $version.Cost.Midpoint}}</strong><small>{{printf "%.1f" $version.CostMultiple}}× baseline</small></div>
      </article>{{end}}
    </div>
  </section>

  <section class="section" aria-labelledby="task-results">
    <div class="section-head">
      <div>
        <h2 id="task-results">Task-level results</h2>
        <p class="section-intro">Latest version. Each track uses the full 0–100% score scale; the shaded interval connects the baseline and version means.</p>
      </div>
    </div>
    <div class="task-list">
      {{range $index, $baselineTask := .BaselineTasks}}{{$versionTask := index $current.Tasks $index}}<article class="task-row" data-task-start="{{$baselineTask.Mean}}" data-task-end="{{$versionTask.Mean}}">
        <div class="task-name"><strong>{{$baselineTask.Task}}</strong><small>{{$baselineTask.Repetitions}} repetitions per arm · {{printf "%.1f%%" (mul100 $baselineTask.Mean)}} → {{printf "%.1f%%" (mul100 $versionTask.Mean)}}</small>{{if or (gt $baselineTask.VerifierBuildFailedRuns 0) (gt $versionTask.VerifierBuildFailedRuns 0)}}<small class="negative">Verifier build failures: baseline {{$baselineTask.VerifierBuildFailedRuns}}, version {{$versionTask.VerifierBuildFailedRuns}}</small>{{end}}</div>
        <div class="task-track" aria-hidden="true"><span class="task-segment {{if lt $versionTask.Difference 0.0}}negative{{end}}"></span><i class="task-point start"></i><i class="task-point end {{if lt $versionTask.Difference 0.0}}negative{{end}}"></i></div>
        <div class="task-delta {{if lt $versionTask.Difference 0.0}}negative{{else}}positive{{end}}">{{printf "%+.1f pts" (mul100 $versionTask.Difference)}}</div>
      </article>{{end}}
    </div>
  </section>

  <section class="supporting" aria-labelledby="supporting-evidence">
    <h2 id="supporting-evidence">Supporting evidence</h2>
    <p class="section-intro">Detailed measurements and execution evidence.</p>

    <details>
      <summary>Task scores and repetitions</summary>
      <div class="details-body">
        {{range $versionIndex, $version := .Versions}}<h3>{{$version.Label}}</h3>
        <div class="table-scroll"><table>
          <thead><tr><th>Task</th><th>Repetitions</th><th>Baseline scores</th><th>Version scores</th><th>Verifier build failures</th><th class="number">Change</th></tr></thead>
          <tbody>{{range $taskIndex, $baselineTask := $.ObservedCampaign.BaselineTasks}}{{$versionTask := index $version.Tasks $taskIndex}}<tr><td>{{$baselineTask.Task}}</td><td>{{$baselineTask.Repetitions}} per arm</td><td>{{range $baselineTask.Scores}}{{printf "%.1f%% " (mul100 .)}}{{end}}</td><td>{{range $versionTask.Scores}}{{printf "%.1f%% " (mul100 .)}}{{end}}</td><td>Baseline {{$baselineTask.VerifierBuildFailedRuns}} · version {{$versionTask.VerifierBuildFailedRuns}}</td><td class="number {{if lt $versionTask.Difference 0.0}}negative{{else}}positive{{end}}">{{printf "%+.2f pts" (mul100 $versionTask.Difference)}}</td></tr>{{end}}</tbody>
        </table></div>{{end}}
      </div>
    </details>

    <details>
      <summary>Decision statistics</summary>
      <div class="details-body">
        {{range .Versions}}<h3>{{.Label}}</h3><div class="table-scroll"><table><tbody>
          <tr><th>Result</th><td>{{if eq .Verdict "better"}}Better{{else if eq .Verdict "worse"}}Worse{{else}}Inconclusive{{end}}</td></tr>
          <tr><th>Observed change</th><td>{{printf "%+.4f percentage points" (mul100 .ObservedDifference)}}</td></tr>
          <tr><th>Decision threshold</th><td>±{{printf "%.4f percentage points" (mul100 .DecisionThreshold)}}</td></tr>
          <tr><th>Difference standard error</th><td>{{printf "%.4f percentage points" (mul100 .DifferenceStandardError)}}</td></tr>
          <tr><th>Student’s t critical value</th><td>{{printf "%.4f" .TCriticalValue}}</td></tr>
          <tr><th>Effective degrees of freedom</th><td>{{printf "%.4f" .EffectiveDegreesOfFreedom}}</td></tr>
          <tr><th>Two-sided significance level</th><td>{{printf "%.2f" $.ObservedCampaign.SignificanceLevel}}</td></tr>
        </tbody></table></div>{{end}}
        <p class="note">“Better” requires a change above the positive threshold; “worse” requires a change below the negative threshold. Changes inside the two-sided threshold are inconclusive.</p>
      </div>
    </details>

    <details>
      <summary>Cost and execution details</summary>
      <div class="details-body">
        <div class="table-scroll"><table><tbody>
          <tr><th>Shared baseline</th><td>{{costRange .BaselineCost.Minimum .BaselineCost.Maximum}} · midpoint ${{printf "%.2f" .BaselineCost.Midpoint}}</td></tr>
          {{range .Versions}}<tr><th>{{.Label}}</th><td>{{costRange .Cost.Minimum .Cost.Maximum}} · midpoint ${{printf "%.2f" .Cost.Midpoint}} · {{.InvocationCount}} invocations · {{.DispatchConformantRuns}}/{{.TotalRuns}} dispatch-conformant runs · {{printf "%.1f" .AgentTimeoutMultiplier}}× agent timeout</td></tr>{{end}}
          <tr><th>Campaign total</th><td>{{costRange .CampaignCost.Minimum .CampaignCost.Maximum}} · midpoint ${{printf "%.2f" .CampaignCost.Midpoint}}</td></tr>
          <tr><th>Model contract</th><td>{{.Model}} · {{.Reasoning}} reasoning</td></tr>
          <tr><th>Plan identity</th><td class="hash">{{.PlanID}}</td></tr>
          <tr><th>Cost-axis source</th><td class="hash">{{.CostAxis.ReferenceConfiguration}} · snapshot {{.CostAxis.ReferenceSnapshotSHA256}}</td></tr>
        </tbody></table></div>
      </div>
    </details>

    <details>
      <summary>Scope and limitations</summary>
      <div class="details-body">{{range .Versions}}<h3>{{.Label}}</h3><ul class="method-list">{{range .Limitations}}<li>{{.}}</li>{{end}}</ul>{{end}}</div>
    </details>
  </section>
{{end}}

  <footer class="footer">
    <span>Agent Layer benchmark · offline, self-contained report</span>
    <span class="hash">{{.ComparisonID}}</span>
  </footer>
</main>

<script id="benchmark-report-data" type="application/json">{{json}}</script>
<script>
const report = JSON.parse(document.getElementById("benchmark-report-data").textContent);
const campaign = report.observed_campaign;
if (campaign) {
  const svg = document.getElementById("tradeoff-chart");
  const namespace = "http:" + "//www.w3.org/2000/svg";
  const add = (name, attributes, text) => {
    const element = document.createElementNS(namespace, name);
    for (const [key, value] of Object.entries(attributes)) element.setAttribute(key, value);
    if (text !== undefined) element.textContent = text;
    svg.appendChild(element);
    return element;
  };
  const renderTradeoffChart = () => {
    const compact = svg.clientWidth < 600;
    const width = compact ? 390 : 900;
    const height = compact ? 460 : 500;
    const margin = compact
      ? {top: 28, right: 18, bottom: 72, left: 56}
      : {top: 28, right: 30, bottom: 72, left: 72};
    const plotWidth = width - margin.left - margin.right;
    const plotHeight = height - margin.top - margin.bottom;
    const costMaximum = campaign.cost_axis.maximum_usd;
    const x = value => {
      const bounded = Math.max(0, Math.min(costMaximum, value));
      return margin.left + Math.log10(1 + bounded) / Math.log10(1 + costMaximum) * plotWidth;
    };
    const y = value => margin.top + (1 - Math.max(0, Math.min(1, value))) * plotHeight;
    svg.replaceChildren();
    svg.setAttribute("viewBox", `0 0 ${width} ${height}`);

    for (let tick = 0; tick <= 4; tick++) {
      const score = tick / 4;
      const position = y(score);
      add("line", {x1: margin.left, y1: position, x2: width - margin.right, y2: position, class: "chart-grid"});
      add("text", {x: margin.left - 10, y: position + 4, "text-anchor": "end", class: "chart-tick"}, `${score * 100}%`);
    }
    const candidateTicks = [0, 1, 5, 10, 50, 100, 500, 1000, costMaximum];
    const costTicks = [...new Set(candidateTicks.filter(value => value <= costMaximum))].sort((left, right) => left - right);
    for (const cost of costTicks) {
      const position = x(cost);
      add("line", {x1: position, y1: margin.top, x2: position, y2: height - margin.bottom, class: "chart-grid"});
      add("text", {x: position, y: height - margin.bottom + 23, "text-anchor": cost === 0 ? "start" : cost === costMaximum ? "end" : "middle", class: "chart-tick"}, `$${cost}`);
    }
    add("line", {x1: margin.left, y1: height - margin.bottom, x2: width - margin.right, y2: height - margin.bottom, class: "chart-axis"});
    add("line", {x1: margin.left, y1: margin.top, x2: margin.left, y2: height - margin.bottom, class: "chart-axis"});
    add("text", {x: margin.left + plotWidth / 2, y: height - 16, "text-anchor": "middle", class: "chart-axis-label"}, "Arm cost (USD, logarithmic)");
    const scoreLabel = add("text", {x: 16, y: margin.top + plotHeight / 2, "text-anchor": "middle", class: "chart-axis-label"}, "Benchmark score");
    scoreLabel.setAttribute("transform", `rotate(-90 16 ${margin.top + plotHeight / 2})`);

    const versionColors = ["#629ad0", "#3d74ac", "#80c7dc", "#2d5a8a", "#4a85c0"];
    const arms = [{
      label: campaign.baseline_label,
      color: "#64748b",
      cost: campaign.baseline_cost,
      score: campaign.baseline_mean,
      uncertainty: campaign.baseline_standard_error
    }, ...campaign.versions.map((version, index) => ({
      label: version.label,
      color: versionColors[index % versionColors.length],
      cost: version.cost,
      score: version.mean,
      uncertainty: version.standard_error
    }))];
    add("polyline", {
      points: arms.map(arm => `${x(arm.cost.midpoint)},${y(arm.score)}`).join(" "),
      class: "chart-connection"
    });
    arms.forEach((arm, index) => {
      const pointX = x(arm.cost.midpoint);
      const pointY = y(arm.score);
      const costMin = x(arm.cost.minimum);
      const costMax = x(arm.cost.maximum);
      const scoreTop = y(arm.score + arm.uncertainty);
      const scoreBottom = y(arm.score - arm.uncertainty);
      const envelopeX = Math.min(costMin, costMax) - 3;
      const envelopeY = Math.min(scoreTop, scoreBottom);
      const envelopeWidth = Math.max(6, Math.abs(costMax - costMin) + 6);
      const envelopeHeight = Math.max(6, Math.abs(scoreBottom - scoreTop));
      add("rect", {
        x: envelopeX, y: envelopeY, width: envelopeWidth, height: envelopeHeight,
        rx: Math.min(8, envelopeHeight / 2), fill: arm.color, "fill-opacity": ".13",
        stroke: arm.color, class: "chart-envelope"
      });
      add("circle", {cx: pointX, cy: pointY, r: 7, fill: arm.color, class: "chart-point"});
      if (arm.cost.maximum > costMaximum) {
        add("path", {d: `M${width - margin.right - 1} ${pointY - 7}l10 7-10 7Z`, class: "chart-overflow"});
      }
      const rightSide = pointX > margin.left + plotWidth * .68;
      const labelX = rightSide ? pointX - 12 : pointX + 12;
      const anchor = rightSide ? "end" : "start";
      const labelY = Math.max(margin.top + 14, scoreTop - 12 - (index % 2) * 5);
      const chartLabel = compact ? (index === 0 ? "Bare model" : `Version ${index}`) : arm.label;
      add("text", {x: labelX, y: labelY, "text-anchor": anchor, class: "chart-point-label"}, chartLabel);
      add("text", {x: labelX, y: labelY + 17, "text-anchor": anchor, class: "chart-point-value"}, `${(arm.score * 100).toFixed(1)}% · $${arm.cost.midpoint.toFixed(2)}`);
    });
  };
  renderTradeoffChart();
  new ResizeObserver(renderTradeoffChart).observe(svg);

  for (const row of document.querySelectorAll("[data-task-start]")) {
    const start = Math.max(0, Math.min(1, Number(row.dataset.taskStart))) * 100;
    const end = Math.max(0, Math.min(1, Number(row.dataset.taskEnd))) * 100;
    const segment = row.querySelector(".task-segment");
    const startPoint = row.querySelector(".task-point.start");
    const endPoint = row.querySelector(".task-point.end");
    segment.style.left = `${Math.min(start, end)}%`;
    segment.style.width = `${Math.abs(end - start)}%`;
    startPoint.style.left = `${start}%`;
    endPoint.style.left = `${end}%`;
  }
}
</script>
</body>
</html>
