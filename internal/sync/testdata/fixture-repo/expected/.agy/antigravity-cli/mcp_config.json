{
  "mcpServers": {
    "agent-layer": {
      "command": "al",
      "args": [
        "dispatch",
        "mcp-server"
      ]
    },
    "example": {
      "serverUrl": "https://mcp.example.com?token=${AL_EXAMPLE_TOKEN}",
      "headers": {
        "Authorization": "Bearer ${AL_EXAMPLE_TOKEN}"
      }
    }
  }
}
