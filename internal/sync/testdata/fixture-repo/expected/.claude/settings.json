{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "exec al hook herdr claude '__CANONICAL_REPO_ROOT__' # agent-layer-herdr",
            "timeout": 35,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(ls:*)",
      "mcp__agent-layer__*",
      "mcp__example__*"
    ]
  },
  "statusLine": {
    "command": "bash '__REPO_ROOT__/.claude/claude-statusline.sh'",
    "type": "command"
  }
}
