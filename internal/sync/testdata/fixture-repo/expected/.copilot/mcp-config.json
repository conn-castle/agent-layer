{
  "mcpServers": {
    "agent-layer": {
      "type": "stdio",
      "command": "/bin/sh",
      "args": [
        "-c",
        "AL_MCP_WORKING_DIR=$PWD; export AL_MCP_WORKING_DIR; cd \"$1\" \u0026\u0026 exec al dispatch mcp-server",
        "agent-layer-mcp",
        "__REPO_ROOT__"
      ],
      "tools": [
        "*"
      ]
    }
  }
}
