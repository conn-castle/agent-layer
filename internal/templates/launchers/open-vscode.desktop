[Desktop Entry]
Type=Application
Name=Open VS Code
Comment=Open this repo in VS Code with CLAUDE_CONFIG_DIR, CODEX_HOME, and AL_* environment variables
Exec=sh -c "if [ -n \\"\\$2\\" ]; then exec \\"\\$(dirname \\"\\$2\\")/open-vscode.sh\\"; else exec \\"\\$1\\"; fi" _ "__OPEN_VSCODE_SHELL__" %k
Terminal=true
Categories=Development;IDE;
